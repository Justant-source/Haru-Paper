# Haru-Paper Pi 에이전트 환경변수 예시 (docs/init_plan.md 8.1, docs/pi/agent.md)
# 실제 값은 같은 디렉터리의 .env 에 넣는다(.env 는 gitignore). 이 파일에는 비밀값을 넣지 않는다.

# 서버 주소 (Tailscale 내부망, tailscale serve HTTPS)
HARU_SERVER_URL=https://justant-server2.tail2b65d1.ts.net
# 서버 server/.env 의 HARU_DEVICE_TOKEN 과 같은 값 (비워 둠)
HARU_DEVICE_TOKEN=
# 폴링 주기(초). "지금 인쇄" 최대 지연과 같다
HARU_POLL_INTERVAL_SEC=30

# 프린터 연결 방식: usb | bt  (최종 결정은 docs/pi/hardware-verification.md V1~V4)
HARU_TRANSPORT=usb
# HARU_TRANSPORT=bt 일 때 M832 Bluetooth 주소 (예: AA:BB:CC:DD:EE:FF)
HARU_BT_ADDRESS=

# 용지 정책: unverified | status_query | manual_flag  (docs/pi/policy.md)
HARU_PAPER_POLICY=unverified

# 늦은 실행 유예(분)와 재시도 간격(초)
HARU_GRACE_MINUTES=30
HARU_RETRY_INTERVAL_SEC=60

# M832 좌우 정렬 보정(mm). detox-printer E-3 실측 확정값 2.0
HARU_H_OFFSET_MM=2.0

# 로컬 데이터(SQLite, PNG 캐시, 보낸 바이트). 노트북 개발 시에는 쓰기 가능한 경로로 바꿀 것
HARU_DATA_DIR=/var/lib/haru-paper
# 보낸 바이트(.bin) 보관 일수 (SD카드 보호)
HARU_SENT_RETENTION_DAYS=30
