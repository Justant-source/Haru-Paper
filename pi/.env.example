# Haru-Paper Pi 에이전트 환경변수 예시 (docs/init_plan.md 8.1, docs/pi/agent.md)
# 실제 값은 같은 디렉터리의 .env 에 넣는다(.env 는 gitignore). 이 파일에는 비밀값을 넣지 않는다.

# 서버 주소 (Tailscale 내부망, tailscale serve HTTPS)
HARU_SERVER_URL=https://justant-server2.tail2b65d1.ts.net
# 기기 토큰 — M6부터 기기별 DB 해시. 웹앱 로그인 → 기기 → "토큰 발급"(POST /api/devices/me/token)으로
# 1회 표시되는 평문을 여기에 넣는다 (docs/pi/setup.md 5.2). 서버 .env의 단일 토큰은 더 이상 없다
HARU_DEVICE_TOKEN=
# 폴링 주기(초). SSE 깨우기 채널(아래 HARU_EVENTS_ENABLED)이 살아 있으면 "지금 인쇄"는 즉시 반영되고,
# 이 값은 그 채널이 끊겼을 때의 최대 지연이자 순수 폴링일 때의 주기다
HARU_POLL_INTERVAL_SEC=30

# 프린터 드라이버 선택: m832 | fake (printer.md "드라이버 선택은 설정으로 한다" — PoC 운영은 m832, 개발은 fake)
HARU_PRINTER_DRIVER=fake

# 프린터 연결 방식: usb | bt — bt 확정 (V1·V2·V3 통과, 2026-09-17, docs/pi/hardware-verification.md).
# bt 는 SPP/RFCOMM 채널 1, transport/bt.py 구현 완료(docs/pi/transport.md 3절). 운영 Pi는
# 이미 bt로 전환·확인됨 — 새로 값을 넣을 때만 이 기본값(usb)을 그대로 두고 개별 조정
HARU_TRANSPORT=usb
# HARU_TRANSPORT=bt 일 때 M832 Bluetooth 주소. 1호기(Q253E6831170035) = C5:0D:F7:B7:B2:A1 [확인됨·실물].
# Pi에서 bluetoothctl pair/trust 를 먼저 1회 해야 한다 (docs/pi/setup.md). 페어링 직후 콜드 상태에서
# 첫 연결이 타임아웃될 수 있다 — docs/pi/transport.md "주의" 참고
HARU_BT_ADDRESS=

# 용지 정책: unverified | status_query | manual_flag  (docs/pi/policy.md)
HARU_PAPER_POLICY=unverified

# 늦은 실행 유예(분)와 재시도 간격(초)
HARU_GRACE_MINUTES=30
HARU_RETRY_INTERVAL_SEC=60

# M832 좌우 정렬 보정(mm). detox-printer E-3 실측 확정값 2.0
HARU_H_OFFSET_MM=2.0

# 로컬 데이터(SQLite, PNG 캐시, 보낸 바이트). 노트북 개발 시에는 쓰기 가능한 경로로 바꿀 것
HARU_DATA_DIR=/var/lib/haru-paper
# 보낸 바이트(.bin) 보관 일수 (SD카드 보호)
HARU_SENT_RETENTION_DAYS=30

# "지금 인쇄" 명령의 Pi측 자체 TTL(초). 서버가 명령을 10분 뒤 expired 처리하는
# 것과 맞춘 값 [기본값] — 생략하면 600. 서버 만료에 기대지 않고 Pi가 독립적으로
# 판단한다(.temp/05 설계 Q4 B2). 없어도 기동은 된다(필수 키 아님)
HARU_COMMAND_TTL_SEC=600

# SSE 깨우기 채널(GET /api/device/events). 서버가 명령·용지상태·예약변경을 즉시 알려주면
# 다음 폴링을 기다리지 않고 바로 poll을 한 번 더 한다 — 명령 실행 자체는 여전히 poll 경로로만
# 일어난다(이 채널은 신호만 나른다). false로 끄면 순수 폴링(HARU_POLL_INTERVAL_SEC 주기)으로
# 동작한다 — 문제가 생겼을 때의 탈출구. 없어도 기동된다(필수 키 아님, 기본 true)
HARU_EVENTS_ENABLED=true
# 이벤트 스트림 read 타임아웃(초). 이 시간 동안 서버 하트비트조차 안 오면 죽은 연결로 보고
# 재연결한다. 서버 하트비트 기본 15초의 3배 — 없어도 기동된다(기본 45)
HARU_EVENT_READ_TIMEOUT_SEC=45
