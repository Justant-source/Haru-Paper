HARU_DB_NAME=haru_paper
HARU_DB_USER=haru
HARU_DB_PASSWORD=
HARU_DB_ROOT_PASSWORD=
# 이 이메일로 가입한 계정이 관리자(admin)가 된다(.temp/03-플랫폼-작업지시서-v1.0.md 4.1절).
# 기기 토큰은 더 이상 여기 없다 — 앱 "기기" 화면에서 계정별로 발급한다(Q14).
HARU_ADMIN_EMAIL=
# Pi 폴링 주기(초). poll 응답 pollIntervalSec로 Pi에 전달된다. "지금 인쇄" 최대 지연과 같다
HARU_POLL_INTERVAL_SEC=30
HARU_WEB_BIND=127.0.0.1:18080   # 서버 세션이 빈 포트 확인 후 확정
# IP:포트 직접 접속(HTTP, tailscale serve의 hostname+HTTPS와 별도 경로)용.
# 반드시 이 서버의 tailscale IP(예: 100.81.189.92)로 채운다 — 0.0.0.0 절대 금지.
# docker-compose.yml이 이 값을 필수로 요구한다(비어 있으면 기동 실패) — 이 경로가
# 필요 없으면 .env에서 이 줄을 지우는 대신 docker-compose.yml의 해당 ports 항목을 지운다.
HARU_WEB_TAILSCALE_BIND=100.81.189.92:18080
HARU_WEATHER_LAT=37.5663
HARU_WEATHER_LON=126.9779
HARU_UPLOAD_MAX_MB=10
HARU_BACKUP_RETENTION_DAYS=7
# 렌더 다운로드·예약 생성의 소유권 검사를 엄격하게 할지. false(기본)=owner_user_id가 NULL인
# 레거시 렌더·포맷을 허용, true=거부(404). docker-compose.yml의 env_file: .env로 haru-api
# 컨테이너 환경변수에 주입되고, Spring 완화 바인딩이 haru.ownership-strict로 매핑한다.
# V4 백필 + claim-legacy 운영 절차(docs/server/deploy.md)를 마치기 전에는 절대 true로 두지 않는다.
HARU_OWNERSHIP_STRICT=false
TZ=Asia/Seoul
