{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/session-start.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/block-dangerous-git.py",
        "matcher": "git",
        "failClosed": true
      }
    ]
  }
}
